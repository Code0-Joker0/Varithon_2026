# Varithon — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is gitignored and will NOT be committed.
#
# VITE_BACKEND_URL — the base URL of the running FastAPI backend.
#
# Local development (default — no file needed, the code falls back to this):
#   VITE_BACKEND_URL=http://localhost:8000
#
# If the backend is on a different machine (e.g. over Tailscale):
#   VITE_BACKEND_URL=http://100.102.220.16:8000
#
# NOTE: This variable MUST start with VITE_ to be exposed to the browser by Vite.
# See: https://vitejs.dev/guide/env-and-mode.html
VITE_BACKEND_URL=http://localhost:8000
